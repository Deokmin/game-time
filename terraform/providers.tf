# ==============================================================================
# AWS Provider 설정
# ==============================================================================

provider "aws" {
  # 배포 대상 리전 (variables.tf 에서 정의)
  region = var.aws_region

  # 모든 리소스에 공통 태그 적용 (비용 추적 및 리소스 관리 용이)
  default_tags {
    tags = local.common_tags
  }
}
